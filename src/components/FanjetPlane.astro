---
// Top-down FJ-6: the Fan-Jet Lab plane, nose to the right. Drawn to the lab's
// layout at about 3.6 px per metre (13 m span, 8.7 m fuselage), with the six
// nacelles a touch fatter so they read at icon size.
interface Props {
  class?: string;
  // the big copy on /what-if lights its engines one at a time
  numbered?: boolean;
}

const { class: cls = '', numbered = false } = Astro.props;

// nacelle centres in px out from the fuselage axis (1.3, 2.4 and 3.5 m in the
// lab's planeLayout), numbered in pairs from the fuselage out
const NACELLES = [4.7, 8.7, 12.7];
const engines = NACELLES.flatMap((d, i) => [
  { y: 24 - d, n: 1 + 2 * i },
  { y: 24 + d, n: 2 + 2 * i },
]);
---

<svg class={cls} viewBox="0 0 48 48" aria-hidden="true" focusable="false">
  <g class="fj-jets" stroke-linecap="round">
    {engines.map((e) => <line data-jet={numbered ? e.n : undefined} x1="26.4" y1={e.y} x2="15" y2={e.y} />)}
  </g>
  <path class="fj-wing" d="M29.2 21.6 L28.5 1.3 L24.6 1.3 L22.8 21.6 Z M29.2 26.4 L28.5 46.7 L24.6 46.7 L22.8 26.4 Z" />
  <path class="fj-wing" d="M13.4 22 L12.6 15.6 L10.4 15.6 L10.6 22 Z M13.4 26 L12.6 32.4 L10.4 32.4 L10.6 26 Z" />
  <path
    class="fj-body"
    d="M41.4 24 C41.4 22.5 40 21.3 37.6 21.2 L16 21.5 L11.4 22.5 L9.6 24 L11.4 25.5 L16 26.5 L37.6 26.8 C40 26.7 41.4 25.5 41.4 24 Z"
  />
  <ellipse class="fj-glass" cx="37.4" cy="24" rx="1.9" ry="1.5" />
  {
    engines.map((e) => (
      <rect
        class="fj-nacelle"
        data-engine={numbered ? e.n : undefined}
        x="26.2"
        y={e.y - 1.35}
        width="5.4"
        height="2.7"
        rx="1.3"
      />
    ))
  }
</svg>
