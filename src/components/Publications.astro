---
import site from '../data/site.json';
import SectionHeading from './SectionHeading.astro';

const paper = site.publications[0];

// --- the byteplot -------------------------------------------------------
// A malware binary drawn as an image does not look like noise: PE sections
// band horizontally, so .text reads dense, padding reads sparse and resources
// read bright. Deterministic values keep the build output stable.
const COLS = 9;
const ROWS = 16;
// per-row character: 0 dense code, 1 mixed data, 2 bright resource, 3 sparse padding
const bands = [0, 0, 0, 0, 1, 1, 1, 1, 1, 2, 2, 3, 3, 1, 3, 3];
const plot = Array.from({ length: COLS * ROWS }, (_, i) => {
  const x = i % COLS;
  const y = Math.floor(i / COLS);
  const n = ((x * 61 + y * 89 + ((x + y) % 11) * 31) % 100) / 100;
  const band = bands[y];
  const base = band === 0 ? 0.55 : band === 1 ? 0.3 : band === 2 ? 0.45 : 0.08;
  const spread = band === 3 ? 0.14 : 0.42;
  return { x, y, o: base + n * spread, accent: band === 2 };
});

// --- soft voting over 17 families --------------------------------------
const FAMILIES = 17;
const WINNER = 6;
const votes = Array.from({ length: FAMILIES }, (_, i) => {
  if (i === WINNER) return 1;
  const n = ((i * 47 + 13) % 29) / 29;
  return 0.08 + n * 0.3;
});
const VOTERS = 15;
---

<section id="publications" class="mx-auto max-w-5xl scroll-mt-14 px-6 py-32">
  <SectionHeading index="03" label="publications" title="My publications" />

  <article class="card pub-card rounded-2xl" data-reveal>
    <div class="pub-grid">
      <div class="pub-figure" aria-hidden="true">
        <svg viewBox="0 0 320 200" class="pub-svg" preserveAspectRatio="xMidYMid meet">
          <defs>
            <linearGradient id="pub-sweep-fill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="var(--accent-1)" stop-opacity="0" />
              <stop offset="0.5" stop-color="var(--accent-1)" stop-opacity="0.6" />
              <stop offset="1" stop-color="var(--accent-1)" stop-opacity="0" />
            </linearGradient>
            <linearGradient id="pub-bar-win" x1="0" y1="1" x2="0" y2="0">
              <stop offset="0" stop-color="var(--accent-1)" stop-opacity="0.55" />
              <stop offset="1" stop-color="var(--accent-1)" stop-opacity="1" />
            </linearGradient>
            <clipPath id="pub-clip">
              <rect x="16" y="26" width="72" height="144" rx="4" />
            </clipPath>
          </defs>

          <!-- 1. the binary, drawn as an image: sections band horizontally -->
          <g clip-path="url(#pub-clip)">
            {
              plot.map((c) => (
                <rect
                  x={16 + c.x * 8}
                  y={26 + c.y * 9}
                  width="8"
                  height="9"
                  fill={c.accent ? 'var(--accent-1)' : 'var(--ink-1)'}
                  opacity={c.o}
                />
              ))
            }
            <rect class="pub-scan" x="16" y="12" width="72" height="22" fill="url(#pub-sweep-fill)" />
          </g>
          <rect x="16" y="26" width="72" height="144" rx="4" fill="none" stroke="var(--line-1)" />
          <text x="52" y="184" text-anchor="middle" class="pub-cap">byteplot</text>

          <!-- 2. three complementary feature tracks, each drawn as itself -->
          <g stroke="var(--accent-1)" stroke-opacity="0.28" fill="none" stroke-width="1">
            <path d="M88 60 H 112" />
            <path d="M88 98 H 112" />
            <path d="M88 136 H 112" />
          </g>

          <!-- HOG: oriented gradient rosette -->
          <g transform="translate(128 60)" class="pub-glyph">
            <circle r="15" fill="none" stroke="var(--line-1)" />
            {
              Array.from({ length: 8 }, (_, k) => {
                const a = (k * Math.PI) / 4;
                const len = 5 + ((k * 3) % 7);
                return (
                  <line
                    x1={Math.cos(a) * 2}
                    y1={Math.sin(a) * 2}
                    x2={Math.cos(a) * (len + 3)}
                    y2={Math.sin(a) * (len + 3)}
                    stroke="var(--accent-1)"
                    stroke-opacity="0.85"
                    stroke-width="1.6"
                    stroke-linecap="round"
                  />
                );
              })
            }
          </g>

          <!-- frozen pretrained backbones: stacked layers, held fixed -->
          <g transform="translate(128 98)" class="pub-glyph">
            {
              [-9, -3, 3].map((dy, k) => (
                <rect
                  x="-15"
                  y={dy}
                  width="30"
                  height="5"
                  rx="1.5"
                  fill="var(--accent-1)"
                  opacity={0.35 + k * 0.2}
                />
              ))
            }
            <g stroke="var(--ink-1)" stroke-opacity="0.75" stroke-width="1.3" stroke-linecap="round">
              <path d="M0 11 v8" />
              <path d="M-3.5 13 L0 15.5 L3.5 13" />
              <path d="M-3.5 17.5 L0 15.5 L3.5 17.5" />
            </g>
          </g>

          <!-- custom CNN: a learned kernel sliding the image -->
          <g transform="translate(128 136)" class="pub-glyph">
            {
              Array.from({ length: 9 }, (_, k) => (
                <rect
                  x={-15 + (k % 3) * 10}
                  y={-15 + Math.floor(k / 3) * 10}
                  width="9"
                  height="9"
                  rx="1"
                  fill="var(--accent-1)"
                  opacity={k === 4 ? 0.95 : 0.2 + ((k * 7) % 5) * 0.1}
                />
              ))
            }
          </g>
          <text x="128" y="184" text-anchor="middle" class="pub-cap">3 tracks</text>

          <!-- 3. soft voting: 15 voters, a probability over 17 families -->
          <g stroke="var(--accent-1)" stroke-opacity="0.22" fill="none" stroke-width="1">
            <path class="pub-wire" d="M146 60 C 172 60, 176 96, 196 112" />
            <path class="pub-wire" d="M146 98 C 172 98, 178 108, 196 116" />
            <path class="pub-wire" d="M146 136 C 172 136, 178 126, 196 120" />
          </g>
          {
            [0, 1, 2].map((i) => (
              <circle
                class="pub-pip"
                style={`offset-path: path('${['M146 60 C 172 60, 176 96, 196 112', 'M146 98 C 172 98, 178 108, 196 116', 'M146 136 C 172 136, 178 126, 196 120'][i]}'); --pip-delay: ${i * 0.85}s`}
                r="2.4"
                fill="var(--accent-1)"
              />
            ))
          }

          <!-- the 15 voters -->
          {
            Array.from({ length: VOTERS }, (_, k) => (
              <circle
                class="pub-voter"
                style={`--voter-delay: ${k * 0.12}s`}
                cx={210 + k * 6.6}
                cy="34"
                r="1.9"
                fill="var(--accent-1)"
              />
            ))
          }
          <text x="258" y="24" text-anchor="middle" class="pub-cap">15 voters</text>

          <!-- the resulting distribution over 17 families -->
          {
            votes.map((v, k) => {
              const h = 6 + v * 76;
              const isWin = k === WINNER;
              return (
                <rect
                  class={isWin ? 'pub-bar pub-bar-win' : 'pub-bar'}
                  x={200 + k * 6.4}
                  y={162 - h}
                  width="4.4"
                  height={h}
                  rx="1"
                  fill={isWin ? 'url(#pub-bar-win)' : 'var(--ink-1)'}
                  opacity={isWin ? 1 : 0.22}
                />
              );
            })
          }
          <path d="M198 164 H 310" stroke="var(--line-1)" />
          <text x="254" y="184" text-anchor="middle" class="pub-cap">17 families</text>
        </svg>
      </div>

      <div class="pub-body">
        <p class="font-mono text-[0.7rem] uppercase tracking-[0.15em] text-accent">
          {paper.venue} &middot; {paper.arxivId}
        </p>

        <h3 class="mt-2.5 text-xl font-semibold leading-snug tracking-tight text-ink sm:text-2xl">
          <a
            href={paper.url}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors hover:text-accent"
          >
            {paper.title}
          </a>
        </h3>

        <p class="mt-2 text-sm text-muted">{paper.authors}</p>
        <p class="mt-0.5 text-xs text-muted">{paper.note}</p>

        <p class="mt-4 text-sm leading-relaxed text-ink/75">{paper.summary}</p>

        <dl class="pub-stats">
          {
            paper.stats.map((s) => (
              <div>
                <dt class="font-mono text-lg font-semibold leading-none text-ink">{s.value}</dt>
                <dd class="mt-1.5 font-mono text-[0.62rem] uppercase leading-tight tracking-[0.1em] text-muted">
                  {s.label}
                </dd>
              </div>
            ))
          }
        </dl>

        <div class="mt-5 flex flex-wrap gap-2.5">
          <a class="pub-link" href={paper.url} target="_blank" rel="noopener noreferrer">arXiv &#8599;</a>
          <a class="pub-link" href={paper.pdf} target="_blank" rel="noopener noreferrer">pdf &#8595;</a>
          <a class="pub-link" href={paper.code} target="_blank" rel="noopener noreferrer">code &#8599;</a>
        </div>
      </div>
    </div>
  </article>
</section>

<style>
  .pub-card {
    overflow: hidden;
  }

  .pub-grid {
    display: grid;
  }

  @media (min-width: 880px) {
    .pub-grid {
      grid-template-columns: minmax(0, 336px) minmax(0, 1fr);
      align-items: stretch;
    }
  }

  .pub-figure {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 0.75rem;
    background:
      radial-gradient(110% 80% at 80% 45%, color-mix(in srgb, var(--accent-1) 13%, transparent), transparent 70%),
      linear-gradient(140deg, color-mix(in srgb, var(--accent-1) 6%, transparent), transparent 55%);
    border-bottom: 1px solid var(--line-1);
  }

  @media (min-width: 880px) {
    .pub-figure {
      border-bottom: 0;
      border-right: 1px solid var(--line-1);
    }
  }

  .pub-svg {
    width: 100%;
    height: auto;
    max-height: 244px;
  }

  .pub-cap {
    fill: var(--ink-2);
    font-family: var(--font-mono);
    font-size: 7.5px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .pub-body {
    padding: 1.75rem;
  }

  @media (min-width: 880px) {
    .pub-body {
      padding: 2rem 2.25rem;
    }
  }

  .pub-stats {
    margin-top: 1.25rem;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    border-top: 1px solid var(--line-1);
    padding-top: 1.1rem;
  }

  .pub-link {
    border-radius: 9999px;
    border: 1px solid var(--line-1);
    padding: 0.45rem 0.95rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-2);
    transition:
      color 0.35s ease,
      border-color 0.35s ease;
  }

  .pub-link:hover,
  .pub-link:focus-visible {
    color: var(--accent-1);
    border-color: color-mix(in srgb, var(--accent-1) 50%, transparent);
  }

  /* the sweep reads the byteplot, pips carry each track's features to the
     ensemble, voters light up in turn and the winning family settles */
  .pub-scan {
    animation: pub-sweep 6s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }

  .pub-pip {
    offset-distance: 0%;
    animation: pub-travel 3.6s cubic-bezier(0.55, 0, 0.45, 1) infinite;
    animation-delay: var(--pip-delay, 0s);
  }

  .pub-voter {
    animation: pub-vote 3.6s ease-in-out infinite;
    animation-delay: var(--voter-delay, 0s);
  }

  .pub-bar-win {
    transform-box: fill-box;
    transform-origin: bottom;
    animation: pub-settle 3.6s cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }

  @keyframes pub-sweep {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(150px);
    }
  }

  @keyframes pub-travel {
    0% {
      offset-distance: 0%;
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    80% {
      opacity: 1;
    }
    100% {
      offset-distance: 100%;
      opacity: 0;
    }
  }

  @keyframes pub-vote {
    0%,
    60%,
    100% {
      opacity: 0.25;
    }
    30% {
      opacity: 1;
    }
  }

  @keyframes pub-settle {
    0%,
    100% {
      transform: scaleY(0.82);
    }
    55% {
      transform: scaleY(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pub-scan,
    .pub-pip,
    .pub-voter,
    .pub-bar-win {
      animation: none;
    }
    .pub-pip {
      offset-distance: 65%;
    }
    .pub-voter {
      opacity: 0.8;
    }
  }
</style>
