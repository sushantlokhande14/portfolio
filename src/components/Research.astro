---
import site from '../data/site.json';
import SectionHeading from './SectionHeading.astro';

// some entries link out (e.g. a paper on arXiv); most do not
const research = site.research as Array<{
  tag?: string;
  title: string;
  detail: string;
  url?: string;
}>;
---

<section id="research" class="mx-auto max-w-5xl scroll-mt-14 px-6 py-32">
  <SectionHeading index="04" label="research" title="Research & awards" />
  <div class="grid gap-5 sm:grid-cols-2">
    {
      research.map((item, i) => (
        <div class="card rounded-2xl p-7" data-reveal style={`--reveal-delay: ${i * 80}ms`}>
          {item.tag && (
            <p class="font-mono text-xs uppercase tracking-[0.15em] text-accent">{item.tag}</p>
          )}
          <p class="mt-3 text-lg font-medium leading-snug text-ink">
            {item.url ? (
              <a
                href={item.url}
                target="_blank"
                rel="noopener noreferrer"
                class="transition-colors hover:text-accent"
              >
                {item.title}
              </a>
            ) : (
              item.title
            )}
          </p>
          <p class="mt-3 text-sm text-muted">{item.detail}</p>
        </div>
      ))
    }
  </div>
</section>
