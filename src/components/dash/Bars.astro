---
// A ranked list where the bar is a background fill on the row itself, so the
// magnitude reads without a separate axis or legend.
interface Props {
  title: string;
  rows: { label: string; value: number; sub?: string }[];
  empty?: string;
}
const { title, rows, empty = 'nothing yet' } = Astro.props as Props;
const max = Math.max(1, ...rows.map((r) => r.value));
---

<div class="card rounded-2xl p-6">
  <h3 class="font-mono text-xs uppercase tracking-[0.2em] text-muted">{title}</h3>
  {rows.length === 0 ? (
    <p class="mt-4 text-sm text-muted">{empty}</p>
  ) : (
    <ul class="mt-4 space-y-1.5">
      {rows.map((r) => (
        <li class="row" style={`--fill:${(r.value / max) * 100}%`}>
          <span class="label" title={r.label}>{r.label}</span>
          <span class="value">
            {r.value.toLocaleString()}
            {r.sub && <em>{r.sub}</em>}
          </span>
        </li>
      ))}
    </ul>
  )}
</div>

<style>
  .row {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    padding: 7px 10px;
    border-radius: 7px;
    overflow: hidden;
    font-size: 13.5px;
  }
  .row::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--fill);
    background: color-mix(in srgb, var(--accent-1) 12%, transparent);
    border-radius: 7px;
  }
  .label,
  .value {
    position: relative;
    z-index: 1;
  }
  .label {
    color: var(--ink-1);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .value {
    font-family: ui-monospace, monospace;
    color: var(--ink-2);
    white-space: nowrap;
  }
  .value em {
    font-style: normal;
    opacity: 0.65;
    margin-left: 7px;
  }
</style>
