---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import Beacon from '../components/Beacon.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  // a page that brings its own look: no nav, no footer, no backdrop
  bare?: boolean;
  // morph between pages that also opt in (the domain pages and case studies);
  // the morph styles live in styles/domains.css
  viewTransitions?: boolean;
}

const {
  title,
  description = 'Portfolio of Sushant Lokhande — software engineer and CS grad student at SJSU.',
  noindex = false,
  bare = false,
  viewTransitions = false,
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      // set theme before first paint to avoid a flash of the wrong theme
      // defaults to light unless the visitor has explicitly chosen dark
      const stored = localStorage.getItem('theme');
      document.documentElement.classList.toggle('dark', stored === 'dark');
      // arriving through a view transition: the morph is the entrance, so marked
      // elements skip their load-time reveal. pagereveal fires before first
      // paint, so this has to be in the head.
      addEventListener('pagereveal', (e) => {
        if (e.viewTransition) document.documentElement.classList.add('vt-arrive');
      });
    </script>
    {/* inline rather than in a stylesheet, so the opt-in is already there when
        the page being opened is revealed */}
    {
      viewTransitions && (
        <style is:inline>
          @media (prefers-reduced-motion: no-preference) {
            @view-transition {
              navigation: auto;
            }
          }
        </style>
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f5f5f7" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0a0a" />
    <title>{title}</title>
    <Analytics />
    <Beacon />
  </head>
  <body>
    {!bare && <div class="page-bg" aria-hidden="true"></div>}
    {!bare && <Nav />}
    <main>
      <slot />
    </main>
    {!bare && <Footer />}
    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }
        },
        { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
