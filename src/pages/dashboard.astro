---
import Layout from '../layouts/Layout.astro';
import Chart from '../components/dash/Chart.astro';
import Bars from '../components/dash/Bars.astro';
import Heatmap from '../components/dash/Heatmap.astro';
import Stat from '../components/dash/Stat.astro';
import { isAuthed } from '../lib/auth';
import { hasDatabase } from '../lib/db';
import { getStats, parseRange } from '../lib/stats';

// Rendered per request: it reads a cookie and live data, so it can never be
// prerendered or cached.
export const prerender = false;

const authed = isAuthed(Astro.cookies);
const failed = Astro.url.searchParams.get('e') === '1';
const range = parseRange(Astro.url.searchParams.get('range'));

let stats = null;
let error: string | null = null;
if (authed) {
  if (!hasDatabase()) {
    error = 'DATABASE_URL is not set, so there is nothing to read yet.';
  } else {
    try {
      stats = await getStats(range);
    } catch (err) {
      error = err instanceof Error ? err.message : 'Could not load stats.';
    }
  }
}

const flag = (cc: string) =>
  cc && cc.length === 2 && cc !== '??'
    ? String.fromCodePoint(...[...cc.toUpperCase()].map((c) => 127397 + c.charCodeAt(0)))
    : '🌐';

const REGION = new Intl.DisplayNames(['en'], { type: 'region' });
const countryName = (cc: string) => {
  if (!cc || cc.length !== 2 || cc === '??') return 'Unknown';
  try {
    return REGION.of(cc.toUpperCase()) ?? cc;
  } catch {
    return cc;
  }
};

const ago = (iso: string) => {
  const s = Math.max(0, (Date.now() - new Date(iso).getTime()) / 1000);
  if (s < 60) return 'just now';
  if (s < 3600) return `${Math.floor(s / 60)}m ago`;
  if (s < 86400) return `${Math.floor(s / 3600)}h ago`;
  return `${Math.floor(s / 86400)}d ago`;
};

const prettyDay = (iso: string | null) =>
  iso
    ? new Date(iso + 'T00:00:00Z').toLocaleDateString('en-US', {
        month: 'short',
        day: 'numeric',
        timeZone: 'UTC',
      })
    : '—';

const ranges = [7, 30, 90, 365] as const;
const rangeLabel = (r: number) => (r === 365 ? '1y' : `${r}d`);
---

<Layout title="Dashboard — Sushant Lokhande" description="Private analytics dashboard." noindex>
  <section class="mx-auto max-w-6xl px-6 py-32">
    {
      !authed ? (
        <div class="mx-auto max-w-sm">
          <h1 class="text-3xl font-semibold tracking-tight text-ink">Dashboard</h1>
          <p class="mt-3 text-sm text-muted">This one is just for me.</p>
          <form method="POST" action="/api/login" class="mt-8 space-y-3">
            <input
              type="password"
              name="password"
              placeholder="password"
              autocomplete="current-password"
              required
              autofocus
              class="w-full rounded-xl border border-line bg-transparent px-4 py-3 text-ink outline-none focus:border-accent"
            />
            <button
              type="submit"
              class="btn-primary w-full rounded-xl px-4 py-3 text-sm font-medium transition-opacity hover:opacity-85"
            >
              Enter
            </button>
            {failed && <p class="text-sm text-red-500">Wrong password.</p>}
          </form>
        </div>
      ) : (
        <>
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="font-mono text-xs uppercase tracking-[0.2em] text-muted">
                <span class="text-accent">·</span> analytics
              </p>
              <h1 class="text-gradient mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">
                Who has been by.
              </h1>
            </div>
            <div class="flex items-center gap-2">
              {ranges.map((r) => (
                <a
                  href={`/dashboard?range=${r}`}
                  class={`rounded-full border px-3.5 py-1.5 font-mono text-xs transition-colors ${
                    r === range
                      ? 'border-accent text-accent'
                      : 'border-line text-muted hover:border-accent hover:text-accent'
                  }`}
                >
                  {rangeLabel(r)}
                </a>
              ))}
              <form method="POST" action="/api/logout">
                <button class="rounded-full border border-line px-3.5 py-1.5 font-mono text-xs text-muted transition-colors hover:border-accent hover:text-accent">
                  sign out
                </button>
              </form>
            </div>
          </div>

          {error ? (
            <div class="card mt-10 rounded-2xl p-7">
              <p class="text-sm text-muted">{error}</p>
            </div>
          ) : (
            stats && (
              <>
                <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
                  <Stat
                    label="views"
                    value={stats.totals.views.toLocaleString()}
                    now={stats.totals.views}
                    prev={stats.totals.prevViews}
                  />
                  <Stat
                    label="visitors"
                    value={stats.totals.visitors.toLocaleString()}
                    now={stats.totals.visitors}
                    prev={stats.totals.prevVisitors}
                  />
                  <Stat
                    label="views / visitor"
                    value={stats.totals.perVisitor || '—'}
                    now={stats.totals.perVisitor}
                    prev={stats.totals.prevPerVisitor}
                  />
                  <Stat
                    label="today"
                    value={stats.totals.today.toLocaleString()}
                    note={
                      stats.best.day
                        ? `best ${prettyDay(stats.best.day)} · ${stats.best.views}`
                        : undefined
                    }
                  />
                </div>

                <div class="card mt-5 rounded-2xl p-7">
                  <div class="flex flex-wrap items-baseline justify-between gap-3">
                    <h3 class="font-mono text-xs uppercase tracking-[0.2em] text-muted">over time</h3>
                    <p class="font-mono text-[11px] text-muted">
                      <span class="text-accent">━</span> views
                      <span class="ml-3">┄ visitors</span>
                      <span class="ml-3 opacity-70">
                        {stats.totals.activeDays} day{stats.totals.activeDays === 1 ? '' : 's'} with
                        traffic
                      </span>
                    </p>
                  </div>
                  <div class="mt-5">
                    <Chart series={stats.series} />
                  </div>
                </div>

                <div class="mt-5">
                  <Heatmap cells={stats.heatmap} />
                </div>

                <div class="mt-5 grid gap-5 lg:grid-cols-2">
                  <Bars
                    title="most read"
                    empty="no page views in this window"
                    rows={stats.pages.map((p) => ({
                      label: p.path,
                      value: p.views,
                      sub: `${p.visitors} vis`,
                    }))}
                  />
                  <Bars
                    title="how they found it"
                    empty="no traffic yet"
                    rows={stats.channels.map((c) => ({ label: c.channel, value: c.views }))}
                  />
                  <Bars
                    title="referrers"
                    empty="no referrers yet"
                    rows={stats.referrers.map((r) => ({ label: r.source, value: r.views }))}
                  />
                  <Bars
                    title="countries"
                    empty="no locations yet"
                    rows={stats.countries.map((c) => ({
                      label: `${flag(c.country)}  ${countryName(c.country)}`,
                      value: c.views,
                    }))}
                  />
                  <Bars
                    title="device"
                    rows={stats.devices.map((d) => ({ label: d.device, value: d.views }))}
                  />
                  <Bars
                    title="browser"
                    rows={stats.browsers.map((b) => ({ label: b.browser, value: b.views }))}
                  />
                  <Bars
                    title="operating system"
                    rows={stats.systems.map((s) => ({ label: s.os, value: s.views }))}
                  />
                  <div class="card rounded-2xl p-6">
                    <h3 class="font-mono text-xs uppercase tracking-[0.2em] text-muted">
                      how this counts
                    </h3>
                    <ul class="mt-4 space-y-2.5 text-[12.5px] leading-relaxed text-muted">
                      <li>A refresh inside 30 minutes is the same view, not a new one.</li>
                      <li>Your own visits are excluded while you are signed in here.</li>
                      <li>Bots, crawlers, and link unfurlers are filtered out.</li>
                      <li>
                        A visitor is a hash that rotates at midnight, so one person across three
                        days counts three times. This is daily reach, not distinct people.
                      </li>
                      <li>No cookies for visitors, and no raw IP is ever stored.</li>
                    </ul>
                  </div>
                </div>

                <div class="card mt-5 rounded-2xl p-7">
                  <h3 class="font-mono text-xs uppercase tracking-[0.2em] text-muted">latest</h3>
                  {stats.recent.length === 0 ? (
                    <p class="mt-4 text-sm text-muted">No views recorded yet.</p>
                  ) : (
                    <ul class="mt-4 divide-y divide-line font-mono text-xs">
                      {stats.recent.map((r) => (
                        <li class="flex flex-wrap items-center gap-x-4 gap-y-1 py-2.5">
                          <span class="w-16 shrink-0 text-muted">{ago(r.ts)}</span>
                          <span class="text-ink">{r.path}</span>
                          <span class="text-muted" title={countryName(r.country ?? '??')}>
                            {flag(r.country ?? '??')}
                          </span>
                          <span class="text-muted opacity-70">
                            {r.browser} · {r.device}
                          </span>
                          {r.referrer && <span class="text-accent">via {r.referrer}</span>}
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </>
            )
          )}
        </>
      )
    }
  </section>
</Layout>
