---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import OpenSource from '../components/OpenSource.astro';
import Projects from '../components/Projects.astro';
import Publications from '../components/Publications.astro';
import Journey from '../components/Journey.astro';
import Research from '../components/Research.astro';
import Skills from '../components/Skills.astro';
import About from '../components/About.astro';
import Airstrip from '../components/Airstrip.astro';
---

<Layout title="Sushant Lokhande — Software Engineer">
  <Hero />
  <OpenSource />
  <Projects />
  <Publications />
  <Journey />
  <Research />
  <Skills />
  <About />
  <div class="mx-auto flex max-w-5xl justify-end px-6 pb-16">
    <Airstrip runway={2} />
  </div>
</Layout>
